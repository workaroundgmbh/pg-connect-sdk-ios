{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","metadata":{"title":"Connect to INSIGHT","modules":[{"name":"ConnectSDK"}],"role":"article","roleHeading":"Article"},"abstract":[{"type":"text","text":"Connect your iOS devices to the INSIGHT webportal to send scanner and telemetry data."}],"hierarchy":{"paths":[["doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK","doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/connectivity"]]},"identifier":{"url":"doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/connect-to-insight","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/provision-a-device"]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/connectsdk\/connect-to-insight"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/connectsdk\/connect-to-insight"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"To send scanner and other data to the "},{"type":"reference","isActive":true,"identifier":"https:\/\/insight.proglove.com\/"},{"type":"text","text":", each iOS device must be connected to your INSIGHT account. In the webportal you create a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Connectivity Device"}]},{"type":"text","text":" under a level of your "},{"type":"strong","inlineContent":[{"type":"text","text":"My Organization"}]},{"type":"text","text":" hierarchy, then connect the device either by scanning a QR code with a ProGlove scanner or by loading a downloaded staging certificate ("},{"type":"codeVoice","code":".fleet"},{"type":"text","text":" file) through the SDK."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The webportal steps (creating the hierarchy, generating the QR code, downloading the staging certificate) are performed in "},{"type":"reference","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"INSIGHT"}],"identifier":"https:\/\/insight.proglove.com\/","overridingTitle":"INSIGHT"},{"type":"text","text":" — see the online guide "},{"type":"reference","identifier":"https:\/\/docs.proglove.com\/en\/connect-insight-mobile--ios--to-insight.html","isActive":true},{"type":"text","text":" for the full portal walkthrough and screenshots. This article focuses on the SDK integration."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Connecting a single device by scanning a QR code is available from INSIGHT Mobile (iOS) 2.0.0. Connecting multiple devices with a single "},{"type":"codeVoice","code":".fleet"},{"type":"text","text":" file is available from 2.5.0."}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"},{"type":"heading","level":3,"text":"Connect by scanning a QR code","anchor":"Connect-by-scanning-a-QR-code"},{"inlineContent":[{"type":"text","text":"In INSIGHT, open "},{"type":"strong","inlineContent":[{"type":"text","text":"Devices"}]},{"type":"text","text":", select the target level in "},{"type":"strong","inlineContent":[{"type":"text","text":"My Organization"}]},{"type":"text","text":", and choose "},{"type":"strong","inlineContent":[{"type":"text","text":"Connect via QR Code"}]},{"type":"text","text":". Scan the generated QR code with your connected ProGlove scanner. The SDK detects the provisioning payload and connects the device to INSIGHT automatically — no additional API call is required. After a few seconds, refresh the "},{"type":"strong","inlineContent":[{"type":"text","text":"Connectivity Devices"}]},{"type":"text","text":" list in the portal to confirm the device appears under the selected level."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Connect by provisioning a local file","anchor":"Connect-by-provisioning-a-local-file"},{"inlineContent":[{"type":"text","text":"For fleet deployments, download the staging certificate ("},{"type":"codeVoice","code":".fleet"},{"type":"text","text":" file) from INSIGHT and place it on the device, then provision it locally with the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/PGCloudManager"},{"type":"text","text":" exposed by the central manager ("},{"type":"codeVoice","code":"PGCentralManager.cloudManager"},{"type":"text","text":"). See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/provision-a-device"},{"type":"text","text":" for the code."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Connection status","anchor":"Connection-status"},{"inlineContent":[{"type":"text","text":"INSIGHT reports one of five connection statuses for a Connectivity device:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Not Registered"}]},{"type":"text","text":" — The Connectivity device was created in INSIGHT, but the provisioning file has not been downloaded or could not be created."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Registering"}],"type":"strong"},{"type":"text","text":" — The provisioning file has been downloaded and placed on the device, which is now trying to connect."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Disconnected"}]},{"type":"text","text":" — The device has not sent any messages for the last two hours."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Connected"}],"type":"strong"},{"type":"text","text":" — The device has paired with a scanner at least once and has sent a message within the last two hours."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Unknown"}]},{"type":"text","text":" — The device is in an undefined connection state."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To verify connectivity, sign in to INSIGHT, open "},{"type":"strong","inlineContent":[{"type":"text","text":"Devices"}]},{"type":"text","text":", and check the "},{"type":"strong","inlineContent":[{"type":"text","text":"Status"}]},{"type":"text","text":" column of the "},{"type":"strong","inlineContent":[{"type":"text","text":"Connectivity Devices"}]},{"type":"text","text":" list. To confirm end-to-end data flow, connect a scanner, scan a barcode, and check that the scanner appears in the "},{"type":"strong","inlineContent":[{"type":"text","text":"Scanners"}]},{"type":"text","text":" list."}]}]}],"references":{"doc://com.proglove.Mark2SDK/documentation/ConnectSDK/provision-a-device":{"kind":"article","url":"\/documentation\/connectsdk\/provision-a-device","identifier":"doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/provision-a-device","abstract":[{"type":"text","text":"Connect an iOS device to INSIGHT from code using a local provisioning file."}],"title":"Provision a Device with a Fleet File","role":"article","type":"topic"},"https://docs.proglove.com/en/connect-insight-mobile--ios--to-insight.html":{"url":"https:\/\/docs.proglove.com\/en\/connect-insight-mobile--ios--to-insight.html","identifier":"https:\/\/docs.proglove.com\/en\/connect-insight-mobile--ios--to-insight.html","type":"link","titleInlineContent":[{"type":"text","text":"Connect INSIGHT Mobile (iOS) to INSIGHT"}],"title":"Connect INSIGHT Mobile (iOS) to INSIGHT"},"https://insight.proglove.com/":{"url":"https:\/\/insight.proglove.com\/","identifier":"https:\/\/insight.proglove.com\/","type":"link","titleInlineContent":[{"type":"text","text":"INSIGHT webportal"}],"title":"INSIGHT webportal"},"doc://com.proglove.Mark2SDK/documentation/ConnectSDK/PGCloudManager":{"kind":"symbol","abstract":[{"type":"text","text":"PGCloudManager pr