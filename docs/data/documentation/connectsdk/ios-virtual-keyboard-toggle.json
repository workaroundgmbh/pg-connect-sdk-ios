{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","metadata":{"roleHeading":"Article","title":"iOS Virtual Keyboard Toggle","modules":[{"name":"ConnectSDK"}],"role":"article"},"abstract":[{"type":"text","text":"Toggle the iOS on-screen keyboard when a ProGlove scanner acts as an input device."}],"hierarchy":{"paths":[["doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK"]]},"identifier":{"url":"doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/ios-virtual-keyboard-toggle","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/initiate-a-scanning-event","doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/initiate-image-streaming-mode","doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/set-up-logging","doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/set-background-operations","doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/device-configurations","doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/update-scanner-firmware","doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/get-device-information","doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/display-sdk","doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/worker-feedback","doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/connectivity"],"anchor":"Features","title":"Features"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/connectsdk\/ios-virtual-keyboard-toggle"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/connectsdk\/ios-virtual-keyboard-toggle"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a ProGlove scanner is connected to an iOS device as a Bluetooth (BLE) HID keyboard, iOS treats it as a hardware keyboard and hides the on-screen (virtual) keyboard by default. This behavior is controlled at the scanner level, not through the SDK — there is no ConnectSDK API to toggle the iOS keyboard. Instead, the scanner is configured by scanning ProGlove configuration barcodes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are two ways to bring back the on-screen keyboard while a scanner is connected via BLE HID:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Double-press the trigger."}]},{"type":"text","text":" Configure the scanner’s double-press action to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Enable the virtual keyboard on double-press"}]},{"type":"text","text":". A double-press of the trigger then shows or hides the keyboard."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Scan a dedicated barcode."}],"type":"strong"},{"type":"text","text":" Scan the "},{"inlineContent":[{"type":"text","text":"Consumer Control key"}],"type":"emphasis"},{"type":"text","text":" configuration barcode to enable the show\/hide keyboard toggle. This is especially useful with the Reel."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The configuration barcodes for the double-press action and the keyboard toggle, along with the "},{"inlineContent":[{"type":"text","text":"Connect scanner via BLE HID"}],"type":"emphasis"},{"type":"text","text":" barcode, are provided in the ProGlove online documentation. See the "},{"type":"reference","identifier":"https:\/\/docs.proglove.com\/en\/ios-virtual-keyboard-toggle.html","isActive":true},{"type":"text","text":" page."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This behavior applies to the scanner operating as a BLE HID input device and is independent of a ConnectSDK "},{"type":"reference","identifier":"doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/PGCentralManager","isActive":true},{"type":"text","text":" connection."}]}],"type":"aside","name":"Note","style":"note"}]}],"references":{"doc://com.proglove.Mark2SDK/documentation/ConnectSDK/worker-feedback":{"kind":"article","url":"\/documentation\/connectsdk\/worker-feedback","identifier":"doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/worker-feedback","abstract":[{"type":"text","text":"Trigger visual, audible, and haptic feedback on a connected scanner."}],"title":"Worker Feedback","role":"article","type":"topic"},"doc://com.proglove.Mark2SDK/documentation/ConnectSDK":{"kind":"symbol","url":"\/documentation\/connectsdk","title":"ConnectSDK","abstract":[{"text":"The ","type":"text"},{"inlineContent":[{"type":"text","text":"ProGlove ConnectSDK"}],"type":"strong"},{"type":"text","text":" is a software development kit that enables integration between your iOS apps and the ProGlove system."}],"identifier":"doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK","role":"collection","type":"topic"},"doc://com.proglove.Mark2SDK/documentation/ConnectSDK/initiate-a-scanning-event":{"kind":"article","url":"\/documentation\/connectsdk\/initiate-a-scanning-event","identifier":"doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/initiate-a-scanning-event","abstract":[{"type":"text","text":"Trigger a scan on a connected ProGlove scanner and receive the scanned barcode."}],"title":"Initiate a Scanning Event","role":"article","type":"topic"},"doc://com.proglove.Mark2SDK/documentation/ConnectSDK/initiate-image-streaming-mode":{"kind":"article","url":"\/documentation\/connectsdk\/initiate-image-streaming-mode","identifier":"doc:\/\/com.proglove.Mark2SDK\/documentation\/ConnectSDK\/initiate-image-streaming-mode","abstract":[{"type":"text","text":"Capture and stream images from a connected ProGlove scanner."}],"title":"Initiate Image Streaming Mode","role":"article","type":"topic"},"https://docs.proglove.com/en/ios-virtual-keyboard-to